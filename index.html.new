<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chad Ranking</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;700;800&display=swap">
<script>try{var t=localStorage.getItem('chad-theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
<style>
:root{--bg:#060c22;--bg2:#0b1745;--surface:#0f1b4d;--surface2:#142268;--ink:#eef2ff;--muted:#9db0ea;--line:rgba(130,160,255,.22);
--accent:#ffc61a;--accent-ink:#0a1440;--hi:#ffd54a;--glow:rgba(255,198,26,.32);--ok:#7fe0a4;--err:#ff9090;--shadow:0 14px 44px rgba(0,0,0,.4);
--disp:Sora,"Segoe UI",system-ui,-apple-system,sans-serif;color-scheme:dark;box-sizing:border-box;padding:env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px)}
:root[data-theme="light"]{--bg:#eef3ff;--bg2:#d6e3ff;--surface:#fff;--surface2:#eaf0ff;--ink:#0b1a52;--muted:#4a5ca0;--line:rgba(30,60,170,.2);
--hi:#1a3ccf;--glow:rgba(26,60,207,.26);--ok:#1c7a45;--err:#c22b2b;--shadow:0 12px 34px rgba(20,40,120,.16);color-scheme:light}
*,*:before,*:after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;color:var(--ink);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;min-height:100vh;
background:radial-gradient(1100px 700px at 12% -10%,var(--bg2),transparent 62%),radial-gradient(900px 600px at 100% 110%,color-mix(in srgb,var(--accent) 16%,transparent),transparent 60%),var(--bg);background-attachment:fixed}
#bg,#fx{position:fixed;inset:0;width:100%;height:100%;pointer-events:none}#bg{z-index:0}#fx{z-index:80}
.shell{position:relative;z-index:1;max-width:1040px;margin:0 auto;padding:18px 16px 60px}
header{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
h1{font:800 clamp(1.7rem,5vw,2.4rem)/1 var(--disp);margin:0;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}
.logo{background:linear-gradient(100deg,var(--hi) 0%,#fff 25%,var(--accent) 50%,var(--hi) 75%,#fff 100%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:gleam 5s linear infinite}
:root[data-theme="light"] .logo{background-image:linear-gradient(100deg,#1a3ccf 0%,#6b8bff 30%,#ffb400 50%,#1a3ccf 75%,#6b8bff 100%)}
.crown{display:inline-block;transform-origin:50% 90%;animation:crown 3.2s ease-in-out infinite;filter:drop-shadow(0 0 10px var(--glow))}
#theme{margin-left:auto;font-size:1.1rem;padding:6px 12px}
#theme.spin span{display:inline-block;animation:spin .6s}
.tag{color:var(--muted);margin:8px 0 16px;font-size:.9rem}
.tabs{position:relative;display:grid;grid-template-columns:1fr 1fr;width:100%;max-width:520px;margin:6px 0 22px;padding:5px;border-radius:16px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 80%,transparent);backdrop-filter:blur(10px)}
.tabs .ind{position:absolute;top:5px;bottom:5px;left:5px;width:calc(50% - 5px);border-radius:12px;background:linear-gradient(135deg,var(--accent),#ffdf6b);box-shadow:0 6px 22px var(--glow);transform:translateX(calc(var(--tab,0)*100%));transition:transform .45s cubic-bezier(.3,1.4,.5,1)}
.tab{position:relative;z-index:1;overflow:hidden;background:none;border:0;color:var(--muted);font:700 .95rem var(--disp);padding:11px 8px;border-radius:12px;cursor:pointer;transition:color .3s}
.tab.on{color:var(--accent-ink)}
.tab .count{display:inline-block;min-width:1.5em;margin-left:6px;border-radius:99px;background:var(--line);padding:0 6px;font-size:.75rem}
.tab.on .count{background:rgba(10,20,64,.18)}
h2{font:800 1.25rem var(--disp);margin:0 0 4px;letter-spacing:-.01em}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:18px;align-items:start}
.card{position:relative;background:linear-gradient(150deg,var(--surface),var(--surface2));border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:var(--shadow)}
.sub{color:var(--muted);font-size:.9rem;margin:0 0 14px}
.spot{position:relative;isolation:isolate}
.spot:before{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),var(--glow),transparent 65%);opacity:0;transition:opacity .35s;pointer-events:none;z-index:-1}
.spot:hover:before{opacity:1}
ol,ul{list-style:none;margin:0;padding:0;display:grid;gap:9px}
.row{position:relative;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;border:1px solid var(--line);border-radius:14px;padding:10px 12px;background:color-mix(in srgb,var(--surface) 88%,transparent);
transition:transform .25s,box-shadow .25s,border-color .3s}
.row:hover{transform:translateY(-2px) scale(1.01);box-shadow:0 10px 28px rgba(0,0,0,.22);border-color:var(--accent)}
.row.drag{transform:scale(1.04);box-shadow:0 18px 40px rgba(0,0,0,.4);border-color:var(--accent);z-index:3}
.rowbtn{all:unset;box-sizing:border-box;cursor:pointer;display:flex;align-items:center;gap:12px;width:100%;flex:1;min-width:0}
.rowbtn:focus-visible{outline:2px solid var(--accent);outline-offset:6px;border-radius:10px}
.handle{cursor:grab;touch-action:none;color:var(--muted);user-select:none;padding:2px 4px;font-size:1.2rem;transition:color .2s,transform .2s}
.handle:hover{color:var(--accent);transform:scale(1.3)}
.pos{font:800 1.15rem var(--disp);color:var(--hi);min-width:1.7em;text-align:center}
.face{width:44px;height:44px;border-radius:50%;flex:none;object-fit:cover;border:2px solid var(--accent);box-shadow:0 0 14px var(--glow);transition:transform .35s}
.row:hover .face,.pod:hover .face{transform:scale(1.14) rotate(-3deg)}
.face.xl{width:84px;height:84px;border-width:3px}
.who{flex:1;min-width:100px;overflow-wrap:anywhere;display:block}.who b{display:block;font-weight:700}.who small{display:block;color:var(--muted)}
.pts{color:var(--muted);font-size:.85rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.score{text-align:right;margin-left:auto;white-space:nowrap}.score b{font:800 1.25rem var(--disp);color:var(--hi);display:block}.score small{color:var(--muted);font-size:.75rem}
.pbar{display:block;height:5px;border-radius:9px;background:var(--line);overflow:hidden;margin-top:6px}
.pbar i{display:block;height:100%;width:var(--w);border-radius:9px;background:linear-gradient(90deg,var(--accent),#fff6c9)}
button{font:inherit}
.btn{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--accent),#ffdf6b);color:var(--accent-ink);border:0;border-radius:12px;padding:10px 18px;cursor:pointer;font:800 .95rem var(--disp);box-shadow:0 6px 20px var(--glow);transition:transform .15s,filter .2s,opacity .2s,box-shadow .2s}
.btn:not(:disabled):hover{transform:translateY(-2px);filter:brightness(1.06);box-shadow:0 10px 28px var(--glow)}
.btn:not(:disabled):after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.55) 50%,transparent 65%);transform:translateX(-120%);animation:sheen 3.4s ease-in-out infinite}
.btn:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
.ghost{position:relative;overflow:hidden;background:none;color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:5px 11px;cursor:pointer;transition:transform .15s,border-color .2s,color .2s,background-color .2s}
.ghost:hover:not(:disabled){border-color:var(--accent);color:var(--hi)}
.ghost:disabled{opacity:.4;cursor:not-allowed}
.btn:active:not(:disabled),.ghost:active:not(:disabled),.tab:active{transform:scale(.93)}
.rip{position:absolute;border-radius:50%;background:currentColor;opacity:.28;transform:scale(0);animation:ripple .6s ease-out forwards;pointer-events:none}
.arrows{display:flex;flex-direction:column;gap:2px}.arrows button{padding:0 8px;line-height:1.2;font-size:.7rem}
.rate{flex-basis:100%;border-top:1px dashed var(--line);padding-top:6px}
.rate summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:8px;font-size:.85rem;color:var(--muted);padding:2px 0;transition:color .2s}
.rate summary::-webkit-details-marker{display:none}
.rate summary:hover{color:var(--hi)}
.rate summary:before{content:"›";display:inline-block;font-size:1.15rem;transition:transform .25s}
.rate[open] summary:before{transform:rotate(90deg)}
.rate .rsum{margin-left:auto;font-variant-numeric:tabular-nums}.rate .rsum.need{color:var(--accent)}
.rate-body{display:flex;flex-wrap:wrap;gap:10px 22px;padding-top:10px}
.rate[open] .rate-body{animation:rise .3s}
.rate label{display:flex;align-items:center;gap:10px;font-size:.85rem;flex:1;min-width:170px}
.rate b{min-width:2.3em;text-align:right;font-variant-numeric:tabular-nums;display:inline-block}.rate b.unset{color:var(--muted)}
input[type=range]{flex:1;min-width:80px;-webkit-appearance:none;appearance:none;height:6px;border-radius:9px;background:var(--line);outline-offset:6px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--accent);border:3px solid var(--surface);box-shadow:0 0 0 2px var(--accent),0 0 14px var(--glow);cursor:grab;transition:transform .15s}
input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--accent);border:3px solid var(--surface);box-shadow:0 0 0 2px var(--accent),0 0 14px var(--glow);cursor:grab}
input[type=range]:hover::-webkit-slider-thumb{transform:scale(1.2)}
input.unset::-webkit-slider-thumb{background:var(--surface);box-shadow:0 0 0 2px var(--muted)}
input.unset::-moz-range-thumb{background:var(--surface);box-shadow:0 0 0 2px var(--muted)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.empty{color:var(--muted);padding:8px 0}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
.chip{border:1px solid var(--line);border-radius:99px;padding:3px 12px;font-size:.8rem;color:var(--muted);background:color-mix(in srgb,var(--surface) 70%,transparent);white-space:nowrap}
button.chip{cursor:pointer;font:inherit;font-size:.8rem;transition:transform .2s,border-color .2s,color .2s}button.chip:hover{border-color:var(--accent);color:var(--hi);transform:translateY(-2px)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;align-items:center}
/* podium */
.podium{display:flex;justify-content:center;align-items:flex-end;gap:clamp(8px,3vw,22px);margin:10px 0 26px}
.pod{all:unset;box-sizing:border-box;cursor:pointer;flex:1;max-width:220px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;position:relative}
.pod:focus-visible{outline:2px solid var(--accent);outline-offset:6px;border-radius:14px}
.pod .pname{font:800 1.05rem var(--disp);overflow-wrap:anywhere}.pod .psub{font-size:.78rem;color:var(--muted)}
.pod .pscore{font:800 1.5rem var(--disp);color:var(--hi)}.pod small{color:var(--muted);font-size:.72rem}
.pbase{width:100%;height:var(--h);margin-top:8px;border-radius:16px 16px 6px 6px;display:grid;place-items:center;font:800 2.4rem var(--disp);color:var(--accent-ink);
background:linear-gradient(180deg,var(--m),color-mix(in srgb,var(--m) 55%,var(--surface)));box-shadow:0 0 30px color-mix(in srgb,var(--m) 45%,transparent);transition:transform .3s}
.pod:hover .pbase{transform:translateY(-4px)}
.r1{--m:#ffc61a}.r2{--m:#b9c6ee}.r3{--m:#d99356}
.r1 .pbase{position:relative;overflow:hidden}.r1 .pbase:after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.55) 50%,transparent 65%);transform:translateX(-120%);animation:sheen 3s ease-in-out infinite}
.r1 .face{box-shadow:0 0 0 4px color-mix(in srgb,var(--m) 35%,transparent),0 0 28px var(--m);animation:pulse 2.4s ease-in-out infinite}
.crownb{font-size:1.8rem;animation:crown 3s ease-in-out infinite;filter:drop-shadow(0 0 10px var(--glow))}
.medal{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font:800 .95rem var(--disp);background:var(--line);flex:none}
/* submit bar */
.submitbar{position:sticky;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:5;margin-top:18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:12px 16px;border-radius:18px;border:1px solid var(--line);
background:color-mix(in srgb,var(--surface) 78%,transparent);backdrop-filter:blur(14px);box-shadow:var(--shadow)}
.submitbar .msg{flex:1;min-width:180px;font-size:.9rem;color:var(--muted)}.msg.ok{color:var(--ok)}.msg.err{color:var(--err)}.msg.in{animation:toast .35s}
.divider{margin:0 0 6px;font-size:.85rem;color:var(--muted)}
/* modal */
.modal{position:fixed;inset:0;z-index:70;display:grid;place-items:center;padding:16px}
.modal[hidden]{display:none}
.scrim{position:absolute;inset:0;background:rgba(3,7,28,.66);backdrop-filter:blur(9px);animation:fade .25s}
.modal.out .scrim{animation:fade .22s reverse forwards}
.sheet{position:relative;width:min(100%,540px);max-height:92vh;overflow:auto;border-radius:24px;padding:22px;background:linear-gradient(150deg,var(--surface),var(--surface2));border:1px solid var(--accent);box-shadow:0 30px 90px rgba(0,0,0,.55),0 0 60px var(--glow);animation:sheetin .5s cubic-bezier(.2,1.2,.3,1)}
.sheet.still{animation:none}
.modal.out .sheet{animation:sheetout .22s ease-in forwards}
.x{position:absolute;top:12px;right:12px;width:36px;height:36px;padding:0;border-radius:50%;font-size:1.1rem}
.hero{display:grid;justify-items:center;text-align:center;gap:4px}
.photo{--rx:0deg;--ry:0deg;width:min(72%,290px);aspect-ratio:1;margin-bottom:10px;perspective:800px}
.photo div{width:100%;height:100%;border-radius:26px;padding:4px;background:conic-gradient(from var(--a,0deg),var(--accent),#3f6bff,#fff,var(--accent));animation:rot 6s linear infinite;transform:rotateX(var(--rx)) rotateY(var(--ry));transition:transform .15s;box-shadow:0 20px 50px rgba(0,0,0,.4),0 0 40px var(--glow)}
.photo img{width:100%;height:100%;object-fit:cover;border-radius:22px;display:block}
.hero h3{font:800 1.6rem var(--disp);margin:0}.hero p{margin:0;color:var(--muted)}.hero .desc{color:var(--ink);max-width:44ch;margin-top:8px}
.rings{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0 8px}
.ringbox{position:relative;text-align:center}.ringbox small{display:block;color:var(--muted);font-size:.72rem}
.ring{width:100%;max-width:120px;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:9;stroke-linecap:round}.ring .bg{stroke:var(--line)}
.ring .fg{stroke:var(--accent);stroke-dasharray:264;stroke-dashoffset:var(--off);filter:drop-shadow(0 0 6px var(--glow))}
.rtxt{position:absolute;left:0;right:0;top:0;aspect-ratio:1;max-width:120px;margin:0 auto;display:grid;place-content:center}
.rtxt b{font:800 1.2rem var(--disp)}.rtxt small{font-size:.7rem}
.facts{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:10px}
/* entrances */
.enter .meta,.enter .chips{animation:rise .5s backwards .1s}
.enter .card,.enter .submitbar{animation:rise .6s backwards;animation-delay:calc(var(--i,0)*100ms + 80ms)}
.enter .row{animation:rise .5s backwards;animation-delay:calc(var(--i,0)*55ms + 260ms)}
.enter .pod{animation:pop .7s backwards;animation-delay:calc(var(--i,0)*140ms + 120ms)}
.enter .pbase{animation:grow .9s cubic-bezier(.2,.9,.2,1) backwards;animation-delay:calc(var(--i,0)*140ms + 200ms)}
.enter .pbar i{animation:fill 1s cubic-bezier(.2,.8,.2,1) .5s backwards}
.enter-m .ring .fg{animation:ring 1.1s cubic-bezier(.2,.8,.2,1) .25s backwards}
.enter-m .rings>*{animation:pop .5s backwards;animation-delay:calc(var(--i,0)*100ms + 150ms)}
@keyframes rise{from{opacity:0;transform:translateY(22px)}}
@keyframes pop{0%{opacity:0;transform:scale(.6) translateY(20px)}70%{transform:scale(1.05)}}
@keyframes grow{from{height:0;opacity:0}}
@keyframes fill{from{width:0}}
@keyframes ring{from{stroke-dashoffset:264}}
@keyframes toast{from{opacity:0;transform:translateY(-6px)}}
@keyframes fade{from{opacity:0}}
@keyframes sheetin{from{opacity:0;transform:translateY(40px) scale(.85);filter:blur(8px)}}
@keyframes sheetout{to{opacity:0;transform:translateY(30px) scale(.92)}}
@keyframes ripple{to{transform:scale(4);opacity:0}}
@keyframes gleam{to{background-position:-250% 0}}
@keyframes crown{0%,100%{transform:rotate(-9deg)}50%{transform:rotate(9deg) translateY(-3px)}}
@keyframes sheen{0%,55%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
@keyframes pulse{50%{transform:scale(1.06)}}
@keyframes spin{from{transform:rotate(-200deg) scale(.4)}}
@keyframes rot{to{--a:360deg}}
@property --a{syntax:"<angle>";initial-value:0deg;inherits:false}
::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
::view-transition-new(root){z-index:9}
@media (prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
<script src="roster.js"></script>
<script src="config.js"></script>
</head>
<body>
<canvas id="bg"></canvas><canvas id="fx"></canvas>
<div class="shell">
  <header>
    <h1><span class="logo">Chad Ranking</span><span class="crown">👑</span></h1>
    <button class="ghost" id="theme" aria-label="Toggle light or dark theme"><span>🌙</span></button>
  </header>
  <p class="tag" id="tag"></p>
  <nav class="tabs" id="tabs" role="tablist" style="--tab:0">
    <i class="ind"></i>
    <button class="tab on" role="tab" data-tab="official">🏆 Official ranking</button>
    <button class="tab" role="tab" data-tab="mine">🗳️ Your ranking<span class="count" id="count">0</span></button>
  </nav>
  <main id="view"><p class="empty">Connecting…</p></main>
</div>
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-label="Profile" hidden></div>
<script>
"use strict";
/* ---------- roster: owner-only, comes from roster.js in the repo ---------- */
const ROSTER = (window.ROSTER || []).map((p, i) => ({ id: p.id || String(p.name).toLowerCase().replace(/\W+/g, '-'), name: p.name, subtitle: p.subtitle || '', description: p.description || '', image: p.image || '', createdAt: i }));
const imgOk = {};
const preload = Promise.all(ROSTER.filter(p => p.image).map(p => new Promise(res => {
  const i = new Image(); i.onload = () => { imgOk[p.image] = true; res(); }; i.onerror = () => res(); i.src = p.image; setTimeout(res, 3500);
})));

/* ---------- storage adapters (votes only) ---------- */
const LS = {
  get(k, d) { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { throw new Error('storage-full'); } }
};
const localAdapter = (() => {
  let vcb = [];
  const votes = () => LS.get('chad:votes', {});
  return {
    mode: 'local', userId: 'local', canWrite: true,
    onRoster(cb) { setTimeout(() => cb(ROSTER), 0); },
    onVotes(cb) { vcb.push(cb); setTimeout(() => cb(votes()), 0); },
    async setMyVote(doc) { const v = votes(); v.local = doc; LS.set('chad:votes', v); vcb.forEach(f => f(v)); }
  };
})();
async function firebaseAdapter(cfg) {
  const base = 'https://www.gstatic.com/firebasejs/10.12.2/';
  const [A, Au, F] = await Promise.all([import(base + 'firebase-app.js'), import(base + 'firebase-auth.js'), import(base + 'firebase-firestore.js')]);
  const app = A.initializeApp(cfg), auth = Au.getAuth(app), db = F.getFirestore(app);
  const uid = (auth.currentUser || (await Au.signInAnonymously(auth)).user).uid;
  return {
    mode: 'shared', userId: uid, canWrite: null,
    onRoster(cb) { setTimeout(() => cb(ROSTER), 0); },
    onVotes(cb, onErr) {
      F.onSnapshot(F.collection(db, 'votes'), snap => { const o = {}; snap.forEach(d => o[d.id] = d.data()); cb(o); },
        e => { onErr && onErr(e); cb({}); });
    },
    setMyVote(d) { return F.setDoc(F.doc(db, 'votes', uid), d); }
  };
}

/* ---------- constants & state ---------- */
const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
const ptsFor = (i, N) => N > 1 ? (N - 1 - i) / (N - 1) * 100 : 100;
const fmt = n => Number.isFinite(n) ? n.toFixed(1) : '–';
let storage = localAdapter, notice = '', votesError = '';
let roster = [], votes = {}, rosterLoaded = false, votesLoaded = false;
let myOrder = [], mySkip = [], dirty = false, mineInit = false, openId = null, tab = location.hash === '#mine' ? 'mine' : 'official';
let dragging = false, sliding = false, pendingRender = false, statusMsg = '', statusKind = '', statusTimer = null, statusFresh = false, focusKey = null;
let queue = Promise.resolve(), lastDoc = null, animate = true, lastFocus = null;
const prevNums = {}, openRate = new Set();
const $view = document.getElementById('view'), $modal = document.getElementById('modal');
const byId = id => roster.find(p => p.id === id);
const myDoc = () => votes[storage.userId] || lastDoc || { order: [], scores: {} };
const myScores = id => (myDoc().scores || {})[id] || {};
const rated = id => Number.isFinite(myScores(id).psl) && Number.isFinite(myScores(id).appeal);

/* ---------- helpers ---------- */
function h(tag, props, ...kids) {
  const e = document.createElement(tag);
  for (const k in (props || {})) {
    const v = props[k];
    if (k === 'class') e.className = v; else if (k === 'text') e.textContent = v;
    else if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
    else if (v === true) e.setAttribute(k, ''); else if (v !== false && v != null) e.setAttribute(k, v);
  }
  kids.flat().forEach(c => { if (c != null && c !== false) e.append(c); });
  return e;
}
const face = (p, xl) => imgOk[p.image] ? h('img', { class: 'face' + (xl ? ' xl' : ''), src: p.image, alt: '' }) : null;
function setStatus(msg, kind) {
  statusMsg = msg; statusKind = kind; statusFresh = true; clearTimeout(statusTimer);
  if (kind === 'ok') statusTimer = setTimeout(() => { statusMsg = ''; statusKind = ''; render(); }, 3500);
  render();
}
function errMsg(e) {
  const m = String((e && (e.code || e.message)) || e);
  if (/permission|denied/i.test(m)) return "You don't have permission to save. Check the Firestore rules in the README.";
  if (/full|quota/i.test(m)) return 'The database is full, so this could not be saved.';
  return "Couldn't save (" + m + ')';
}

/* ---------- aggregation ---------- */
function aggregate() {
  const ids = new Set(roster.map(p => p.id));
  const st = {}; roster.forEach(p => st[p.id] = { p, pts: 0, n: 0, ps: 0, pn: 0, as: 0, an: 0 });
  let ballots = 0;
  Object.keys(votes).sort().map(k => votes[k]).forEach(v => {
    const ord = (v.order || []).filter(id => ids.has(id));
    if (ord.length) ballots++;
    ord.forEach((id, i) => { st[id].pts += ptsFor(i, ord.length); st[id].n++; });
    const sc = v.scores || {};
    for (const id in sc) if (st[id]) {
      if (Number.isFinite(sc[id].psl)) { st[id].ps += Math.min(8, Math.max(1, sc[id].psl)); st[id].pn++; }
      if (Number.isFinite(sc[id].appeal)) { st[id].as += Math.min(10, Math.max(1, sc[id].appeal)); st[id].an++; }
    }
  });
  const all = Object.values(st);
  all.forEach(s => { s.ptsAvg = s.n ? s.pts / s.n : null; s.psl = s.pn ? s.ps / s.pn : null; s.appeal = s.an ? s.as / s.an : null; });
  const nameCmp = (a, b) => a.p.name.localeCompare(b.p.name);
  const ranked = all.filter(s => s.n).sort((a, b) => b.ptsAvg - a.ptsAvg || b.n - a.n || nameCmp(a, b));
  const rankBy = key => {
    const list = all.filter(s => s[key] != null).sort((a, b) => b[key] - a[key] || nameCmp(a, b));
    const m = {}; list.forEach((s, i) => m[s.p.id] = i + 1); return { m, total: list.length };
  };
  return { ballots, ranked, unranked: all.filter(s => !s.n).sort(nameCmp), st, ov: rankBy('ptsAvg'), pr: rankBy('psl'), ar: rankBy('appeal') };
}

/* ---------- writes (serialized) ---------- */
function write(build, okMsg) {
  if (storage.canWrite === false) return setStatus("You don't have permission to save.", 'err');
  if (!storage.userId) return setStatus("Couldn't identify you, so nothing can be saved.", 'err');
  queue = queue.then(async () => {
    try {
      const doc = build(myDoc()); doc.updatedAt = Date.now(); lastDoc = doc;
      await storage.setMyVote(doc);
      if (okMsg) { dirty = false; setStatus(okMsg, 'ok'); confetti(); } else render();
    } catch (e) { setStatus(errMsg(e), 'err'); }
  });
}
function submit() {
  if (myOrder.some(id => !rated(id))) return setStatus('Everyone in the rating list needs both a PSL and an Appeal score.', 'err');
  write(d => ({ order: myOrder.slice(), scores: d.scores || {} }), 'Ballot saved. Thanks!');
}
function saveScore(id, key, val) {
  if (myScores(id)[key] === val) return;
  write(d => {
    const sc = { ...(d.scores || {}) }; sc[id] = { ...(sc[id] || {}), [key]: val };
    return { order: d.order || [], scores: sc };
  });
}

/* ---------- ballot state ---------- */
function tryInit() {
  if (mineInit || !rosterLoaded || !votesLoaded) return;
  mineInit = true;
  const ids = roster.map(p => p.id);
  myOrder = ((votes[storage.userId] || {}).order || []).filter(id => ids.includes(id) && rated(id));
  mySkip = ids.filter(id => !myOrder.includes(id));
}
function move(id, dir) {
  const i = myOrder.indexOf(id), j = i + dir;
  if (j < 0 || j >= myOrder.length) return;
  [myOrder[i], myOrder[j]] = [myOrder[j], myOrder[i]]; dirty = true; focusKey = (dir < 0 ? 'up' : 'dn') + id; render();
}
function skip(id) { myOrder = myOrder.filter(x => x !== id); mySkip.push(id); dirty = true; render(); }
function rank(id) { if (!rated(id)) return; mySkip = mySkip.filter(x => x !== id); myOrder.push(id); dirty = true; render(); }
function goTab(t) { if (t === tab) return; tab = t; history.replaceState(null, '', '#' + t); animate = true; render(); window.scrollTo(0, 0); }

/* ---------- drag ---------- */
function startDrag(ev, list, row) {
  ev.preventDefault(); dragging = true;
  const handle = ev.currentTarget; handle.setPointerCapture(ev.pointerId); row.classList.add('drag');
  const relabel = () => [...list.children].forEach((li, i) => {
    li.querySelector('.pos').textContent = i + 1;
    li.querySelector('.pts').textContent = Math.round(ptsFor(i, list.children.length)) + ' pts';
  });
  const onMove = e => {
    const sib = [...list.children].filter(c => c !== row);
    const next = sib.find(c => { const r = c.getBoundingClientRect(); return e.clientY < r.top + r.height / 2; });
    if (next) { if (row.nextSibling !== next) list.insertBefore(row, next); } else list.appendChild(row);
    relabel();
  };
  const onUp = () => {
    handle.removeEventListener('pointermove', onMove); handle.removeEventListener('pointerup', onUp); handle.removeEventListener('pointercancel', onUp);
    myOrder = [...list.children].map(li => li.dataset.id); dirty = true; dragging = false; pendingRender = false; render();
  };
  handle.addEventListener('pointermove', onMove); handle.addEventListener('pointerup', onUp); handle.addEventListener('pointercancel', onUp);
}

/* ---------- Your ranking tab ---------- */
function rating(id) {
  const sc = myScores(id);
  const slider = (key, label, min, max) => {
    const set = Number.isFinite(sc[key]);
    const val = h('b', { class: set ? '' : 'unset', text: set ? sc[key].toFixed(1) : '—' });
    const inp = h('input', { type: 'range', class: set ? '' : 'unset', min, max, step: 0.5, value: set ? sc[key] : (min + max) / 2, 'aria-label': label + ' rating' });
    inp.addEventListener('input', () => {
      val.textContent = (+inp.value).toFixed(1); val.classList.remove('unset'); inp.classList.remove('unset');
      if (!RM) val.animate([{ transform: 'scale(1.4)', color: 'var(--accent)' }, { transform: 'scale(1)' }], { duration: 220 });
    });
    const commit = () => saveScore(id, key, +inp.value);
    inp.addEventListener('change', commit); inp.addEventListener('pointerup', commit);
    return h('label', {}, label, inp, val);
  };
  const both = rated(id);
  const d = h('details', { class: 'rate' },
    h('summary', {}, h('span', { text: both ? 'PSL & Appeal' : 'Set PSL & Appeal' }),
      h('span', { class: 'rsum' + (both ? '' : ' need'), text: both ? 'PSL ' + fmt(sc.psl) + ' · Appeal ' + fmt(sc.appeal) : (Number.isFinite(sc.psl) || Number.isFinite(sc.appeal) ? 'Set the other one' : 'Not rated') })),
    h('div', { class: 'rate-body' }, slider('psl', 'PSL', 1, 8), slider('appeal', 'Appeal', 1, 10)));
  if (openRate.has(id)) d.open = true;
  d.addEventListener('toggle', () => { if (d.open) openRate.add(id); else openRate.delete(id); });
  return d;
}
function nameBlock(p, link) {
  const inner = [h('b', { text: p.name }), p.subtitle ? h('small', { text: p.subtitle }) : null];
  return link ? h('span', { class: 'who' }, inner) : h('div', { class: 'who' }, h('button', { class: 'link', style: 'all:unset;cursor:pointer;font-weight:700', text: p.name, onclick: () => openProfile(p.id) }), p.subtitle ? h('small', { text: p.subtitle }) : null);
}
function mineView() {
  const N = myOrder.length;
  const list = h('ol');
  myOrder.forEach((id, i) => {
    const p = byId(id); if (!p) return;
    const row = h('li', { class: 'row spot', 'data-id': id, 'data-flip': 'my:' + id, style: '--i:' + i });
    const handle = h('span', { class: 'handle', text: '⠿', 'aria-hidden': 'true' });
    handle.addEventListener('pointerdown', e => startDrag(e, list, row));
    row.append(handle, h('span', { class: 'pos', text: i + 1 }), face(p), nameBlock(p),
      h('span', { class: 'pts', text: Math.round(ptsFor(i, N)) + ' pts' }),
      h('button', { class: 'ghost', text: 'Skip', 'aria-label': 'Move ' + p.name + ' to the skip list', onclick: () => skip(id) }),
      h('span', { class: 'arrows' },
        h('button', { class: 'ghost', text: '▲', 'aria-label': 'Move ' + p.name + ' up', 'data-key': 'up' + id, onclick: () => move(id, -1) }),
        h('button', { class: 'ghost', text: '▼', 'aria-label': 'Move ' + p.name + ' down', 'data-key': 'dn' + id, onclick: () => move(id, 1) })),
      rating(id));
    list.append(row);
  });
  const skipped = h('ul');
  mySkip.forEach((id, i) => {
    const p = byId(id); if (!p) return;
    const ok = rated(id);
    skipped.append(h('li', { class: 'row spot', 'data-flip': 'my:' + id, style: '--i:' + i }, face(p), nameBlock(p),
      h('button', { class: 'ghost', text: 'Add to ranking', disabled: !ok, title: ok ? '' : 'Set both PSL and Appeal first', 'aria-label': 'Add ' + p.name + ' to the rating list', onclick: () => rank(id) }), rating(id)));
  });
  const hasSaved = ((votes[storage.userId] || {}).order || []).length > 0 || !!lastDoc;
  const btn = h('button', { class: 'btn', text: hasSaved ? 'Update ranking' : 'Submit ranking', onclick: submit });
  if ((hasSaved && !dirty) || (!hasSaved && !N)) btn.disabled = true;
  const hint = statusMsg || (!hasSaved && !N ? 'Rate someone and add them to the rating list to submit.' : dirty ? 'You have unsaved changes.' : hasSaved ? 'Your ballot is saved.' : '');
  const ratedCount = roster.filter(p => rated(p.id)).length;
  return h('div', {},
    h('div', { class: 'grid' },
      h('section', { class: 'card', style: '--i:0' }, h('h2', { text: 'Rating list' }),
        h('p', { class: 'sub', text: 'Your ranking, best at the top: 100 points for first place down to 0 for last. Drag or use the arrows.' }),
        N ? list : h('p', { class: 'empty', text: 'Empty. Rate someone in the skip list, then add them here.' })),
      h('section', { class: 'card', style: '--i:1' }, h('h2', { text: 'Skip list' }),
        h('p', { class: 'sub', text: 'Not in your ranking. To add someone, open their row and set both PSL and Appeal first. ' + ratedCount + ' of ' + roster.length + ' rated.' }),
        mySkip.length ? skipped : h('p', { class: 'empty', text: 'Everyone is in your rating list.' }))),
    h('div', { class: 'submitbar', style: '--i:2' }, h('span', { class: 'msg ' + statusKind + (statusFresh ? ' in' : ''), 'aria-live': 'polite', text: hint }), btn));
}

/* ---------- Official ranking tab ---------- */
function officialView(a) {
  const wrap = h('div');
  wrap.append(h('div', { class: 'meta' }, h('span', { class: 'chip', text: a.ballots + (a.ballots === 1 ? ' ballot' : ' ballots') }), h('span', { class: 'chip', text: roster.length + ' people' }),
    h('span', { class: 'chip', text: 'Points out of 100 · higher is better' })));
  if (!a.ranked.length) {
    wrap.append(h('section', { class: 'card', style: '--i:0' }, h('h2', { text: 'No ballots yet' }),
      h('p', { class: 'sub', text: 'Be the first: rate people and build your ranking.' }),
      h('button', { class: 'btn', text: 'Start ranking', onclick: () => goTab('mine') })));
  } else {
    const t = a.ranked.slice(0, 3);
    const pod = (s, rank, i) => h('button', { class: 'pod r' + rank, style: '--h:' + [0, 170, 126, 98][rank] + 'px;--i:' + i, 'aria-label': s.p.name + ', rank ' + rank },
      rank === 1 ? h('span', { class: 'crownb', text: '👑' }) : null, face(s.p, true),
      h('span', { class: 'pname', text: s.p.name }), s.p.subtitle ? h('span', { class: 'psub', text: s.p.subtitle }) : null,
      h('span', { class: 'pscore', 'data-count': s.ptsAvg, 'data-dec': 1, 'data-ck': 'pod' + s.p.id, text: s.ptsAvg.toFixed(1) }),
      h('small', { text: s.n + (s.n === 1 ? ' ballot' : ' ballots') }), h('span', { class: 'pbase' }, h('b', { text: rank })));
    const pods = [t[1] && [t[1], 2, 0], t[0] && [t[0], 1, 1], t[2] && [t[2], 3, 2]].filter(Boolean);
    const podium = h('div', { class: 'podium' }, pods.map(([s, r, i]) => { const b = pod(s, r, i); b.addEventListener('click', () => openProfile(s.p.id)); return b; }));
    wrap.append(podium);
    const rest = a.ranked.slice(3);
    if (rest.length) {
      const list = h('ol');
      rest.forEach((s, i) => list.append(h('li', { class: 'row spot', 'data-flip': 'off:' + s.p.id, style: '--i:' + i },
        h('button', { class: 'rowbtn', 'aria-label': 'Open ' + s.p.name, onclick: () => openProfile(s.p.id) },
          h('span', { class: 'medal', text: i + 4 }), face(s.p),
          h('span', { class: 'who' }, h('b', { text: s.p.name }), s.p.subtitle ? h('small', { text: s.p.subtitle }) : null, h('span', { class: 'pbar' }, h('i', { style: '--w:' + s.ptsAvg + '%' }))),
          h('span', { class: 'score' }, h('b', { 'data-count': s.ptsAvg, 'data-dec': 1, 'data-ck': 'o' + s.p.id, text: s.ptsAvg.toFixed(1) }), h('small', { text: s.n + (s.n === 1 ? ' ballot' : ' ballots') }))))));
      wrap.append(h('section', { class: 'card', style: '--i:1' }, list));
    }
  }
  if (votesError) wrap.append(h('p', { class: 'msg err', text: votesError }));
  if (a.unranked.length && a.ranked.length) wrap.append(h('div', { class: 'chips' }, h('span', { class: 'sub', style: 'margin:0', text: 'Not ranked yet:' }),
    a.unranked.map(s => h('button', { class: 'chip', text: s.p.name, onclick: () => openProfile(s.p.id) }))));
  return wrap;
}

/* ---------- profile window ---------- */
function openProfile(id) { lastFocus = document.activeElement; openId = id; syncModal(true); }
function closeProfile() {
  if (!openId) return; openId = null;
  $modal.classList.add('out');
  setTimeout(() => { if (!openId) { $modal.hidden = true; $modal.classList.remove('out'); $modal.replaceChildren(); document.body.style.overflow = ''; lastFocus && lastFocus.focus && lastFocus.focus(); } }, RM ? 0 : 220);
}
function ring(label, txt, pct, sub, i, ck, count) {
  const box = h('div', { class: 'ringbox', style: '--i:' + i });
  box.innerHTML = '<svg viewBox="0 0 100 100" class="ring"><circle cx="50" cy="50" r="42" class="bg"/><circle cx="50" cy="50" r="42" class="fg" style="--off:' + (264 * (1 - Math.min(100, Math.max(0, pct)) / 100)).toFixed(1) + '"/></svg>';
  box.append(h('div', { class: 'rtxt' }, h('b', count == null ? { text: txt } : { 'data-count': count, 'data-dec': 1, 'data-ck': ck, text: txt }), h('small', { text: label })), h('small', { text: sub }));
  return box;
}
function syncModal(enter) {
  if (!openId || !byId(openId)) { if (openId) { openId = null; } return; }
  const a = aggregate(), s = a.st[openId], p = s.p, mine = myScores(p.id);
  const rk = r => r.m[p.id] ? '#' + r.m[p.id] + ' of ' + r.total : 'not rated';
  const photo = imgOk[p.image] ? h('div', { class: 'photo' }, h('div', {}, h('img', { src: p.image, alt: p.name }))) : null;
  const close = h('button', { class: 'ghost x', text: '✕', 'aria-label': 'Close', onclick: closeProfile });
  const sheet = h('div', { class: 'sheet' + (enter ? '' : ' still') },
    close,
    h('div', { class: 'hero' }, photo, h('h3', { text: p.name }), p.subtitle ? h('p', { text: p.subtitle }) : null, p.description ? h('p', { class: 'desc', text: p.description }) : null),
    h('div', { class: 'rings' },
      ring('points', s.ptsAvg == null ? '–' : s.ptsAvg.toFixed(1), s.ptsAvg || 0, a.ov.m[p.id] ? '#' + a.ov.m[p.id] + ' of ' + a.ov.total : 'not ranked', 0, 'mp', s.ptsAvg),
      ring('PSL', s.psl == null ? '–' : fmt(s.psl), (s.psl || 0) / 8 * 100, rk(a.pr) + ' · ' + s.pn + ' votes', 1, 'ms', s.psl),
      ring('Appeal', s.appeal == null ? '–' : fmt(s.appeal), (s.appeal || 0) / 10 * 100, rk(a.ar) + ' · ' + s.an + ' votes', 2, 'ma', s.appeal)),
    h('div', { class: 'facts' }, h('span', { class: 'chip', text: s.n + (s.n === 1 ? ' ballot' : ' ballots') }),
      h('span', { class: 'chip', text: Number.isFinite(mine.psl) || Number.isFinite(mine.appeal) ? 'Your rating: ' + fmt(mine.psl) + ' · ' + fmt(mine.appeal) : 'You have not rated them' })));
  if (photo) sheet.addEventListener('pointermove', e => {
    const r = photo.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
    photo.style.setProperty('--ry', (x * 14).toFixed(1) + 'deg'); photo.style.setProperty('--rx', (-y * 14).toFixed(1) + 'deg');
  });
  if (photo) sheet.addEventListener('pointerleave', () => { photo.style.setProperty('--ry', '0deg'); photo.style.setProperty('--rx', '0deg'); });
  const scrim = h('div', { class: 'scrim', onclick: closeProfile });
  const top = $modal.querySelector('.sheet'), st = top ? top.scrollTop : 0;
  $modal.classList.toggle('enter-m', !!enter);
  $modal.replaceChildren(scrim, sheet);
  if (!enter) sheet.scrollTop = st;
  $modal.hidden = false; $modal.classList.remove('out'); document.body.style.overflow = 'hidden';
  countUps(!!enter, $modal);
  if (enter) close.focus();
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeProfile(); });

/* ---------- render ---------- */
function themeIcon() { return document.documentElement.getAttribute('data-theme') === 'light' ? '☀️' : '🌙'; }
function countUps(fresh, root) {
  (root || document).querySelectorAll('[data-count]').forEach(el => {
    const to = +el.dataset.count, dec = +el.dataset.dec || 0, k = el.dataset.ck;
    const from = fresh ? 0 : (prevNums[k] ?? 0); prevNums[k] = to;
    if (RM || from === to) return;
    const t0 = performance.now();
    (function step(t) {
      const p = Math.min(1, (t - t0) / 900), e = 1 - Math.pow(1 - p, 3);
      el.textContent = (from + (to - from) * e).toFixed(dec);
      if (p < 1) requestAnimationFrame(step);
    })(t0);
  });
}
function render() {
  if (dragging || sliding) { pendingRender = true; return; }
  const ready = rosterLoaded && votesLoaded && mineInit;
  const enter = ready && animate && !RM;
  if (ready && animate) animate = false;
  if (enter) Object.keys(prevNums).forEach(k => delete prevNums[k]);
  document.getElementById('tabs').style.setProperty('--tab', tab === 'mine' ? 1 : 0);
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('on', b.dataset.tab === tab));
  document.getElementById('count').textContent = myOrder.length;
  document.querySelector('#theme span').textContent = themeIcon();
  document.getElementById('tag').textContent = (storage.mode === 'shared' ? 'Everyone’s ballots count live.' : 'Votes are NOT shared yet: your ballot is saved in this browser only until the owner connects the shared database.') + notice;
  if (!ready) return;
  const scrollY = window.scrollY, old = {};
  $view.querySelectorAll('[data-flip]').forEach(e => { old[e.dataset.flip] = e.getBoundingClientRect(); });
  if (!roster.length) { $view.replaceChildren(h('p', { class: 'empty', text: window.ROSTER ? 'The roster is empty. Check back soon.' : "roster.js didn't load. Make sure it sits next to index.html in the repo." })); return; }
  $view.className = enter ? 'enter' : '';
  $view.replaceChildren(tab === 'mine' ? mineView() : officialView(aggregate()));
  statusFresh = false;
  window.scrollTo(0, scrollY);
  if (!enter && !RM) $view.querySelectorAll('[data-flip]').forEach(e => {
    const o = old[e.dataset.flip]; if (!o) return;
    const n = e.getBoundingClientRect(), dx = o.left - n.left, dy = o.top - n.top;
    if (Math.abs(dx) + Math.abs(dy) > 1) e.animate([{ transform: `translate(${dx}px,${dy}px)` }, { transform: 'none' }], { duration: 480, easing: 'cubic-bezier(.2,.8,.2,1)' });
  });
  countUps(enter, $view);
  if (focusKey) { const b = $view.querySelector('[data-key="' + focusKey + '"]'); if (b) b.focus(); focusKey = null; }
  if (openId) syncModal(false);
}

/* ---------- global interactions ---------- */
document.getElementById('tabs').addEventListener('click', e => { const b = e.target.closest('.tab'); if (b) goTab(b.dataset.tab); });
window.addEventListener('hashchange', () => { const t = location.hash === '#mine' ? 'mine' : 'official'; if (t !== tab) { tab = t; animate = true; render(); } });
document.addEventListener('pointerdown', e => {
  if (e.target.type === 'range') sliding = true;
  const b = e.target.closest && e.target.closest('.btn,.ghost,.tab');
  if (b && !RM) { const r = b.getBoundingClientRect(), d = Math.max(r.width, r.height), s = h('span', { class: 'rip', style: `width:${d}px;height:${d}px;left:${e.clientX - r.left - d / 2}px;top:${e.clientY - r.top - d / 2}px` }); b.append(s); s.addEventListener('animationend', () => s.remove()); }
});
window.addEventListener('pointercancel', () => { sliding = false; });
window.addEventListener('pointerup', () => { sliding = false; if (!dragging && pendingRender) { pendingRender = false; setTimeout(render, 60); } });
document.addEventListener('pointermove', e => {
  const t = e.target.closest && e.target.closest('.spot'); if (!t) return;
  const r = t.getBoundingClientRect(); t.style.setProperty('--mx', (e.clientX - r.left) + 'px'); t.style.setProperty('--my', (e.clientY - r.top) + 'px');
});
function setTheme(next, x, y) {
  const apply = () => { document.documentElement.setAttribute('data-theme', next); try { localStorage.setItem('chad-theme', next); } catch (e) {} render(); };
  if (!document.startViewTransition || RM) return apply();
  const t = document.startViewTransition(apply);
  t.ready.then(() => {
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    document.documentElement.animate({ clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] }, { duration: 700, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' });
  }).catch(() => {});
}
document.getElementById('theme').addEventListener('click', e => {
  const b = e.currentTarget, r = b.getBoundingClientRect();
  b.classList.remove('spin'); void b.offsetWidth; b.classList.add('spin');
  setTheme(document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light', r.left + r.width / 2, r.top + r.height / 2);
});

/* ---------- background particles & confetti ---------- */
(function () {
  const c = document.getElementById('bg'), x = c.getContext && c.getContext('2d'); if (!x) return;
  let W, H, P = [];
  const light = () => document.documentElement.getAttribute('data-theme') === 'light';
  const col = (a, gold) => gold ? `rgba(255,${light() ? 175 : 198},26,${a})` : (light() ? `rgba(26,60,207,${a})` : `rgba(140,175,255,${a})`);
  function size() { W = c.width = innerWidth; H = c.height = innerHeight; P = Array.from({ length: Math.min(70, Math.round(W * H / 21000)) }, () => ({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .28, vy: (Math.random() - .5) * .28, r: Math.random() * 1.8 + .7, t: Math.random() * 6.28, g: Math.random() < .35 })); }
  function frame() {
    x.clearRect(0, 0, W, H);
    P.forEach(p => { p.x = (p.x + p.vx + W) % W; p.y = (p.y + p.vy + H) % H; p.t += .03; x.fillStyle = col(.3 + .35 * Math.sin(p.t), p.g); x.beginPath(); x.arc(p.x, p.y, p.r, 0, 7); x.fill(); });
    for (let i = 0; i < P.length; i++) for (let j = i + 1; j < P.length; j++) {
      const dx = P[i].x - P[j].x, dy = P[i].y - P[j].y, d = Math.hypot(dx, dy);
      if (d < 115) { x.strokeStyle = col((1 - d / 115) * .16, false); x.beginPath(); x.moveTo(P[i].x, P[i].y); x.lineTo(P[j].x, P[j].y); x.stroke(); }
    }
    if (!RM && !document.hidden) requestAnimationFrame(frame);
  }
  size(); frame();
  addEventListener('resize', () => { size(); if (RM) frame(); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden && !RM) frame(); });
})();
function confetti() {
  if (RM) return;
  const c = document.getElementById('fx'), x = c.getContext && c.getContext('2d'); if (!x) return;
  c.width = innerWidth; c.height = innerHeight;
  const cols = ['#ffc61a', '#ffdf6b', '#3f6bff', '#8fb0ff', '#ffffff'];
  const P = Array.from({ length: 110 }, () => ({ x: innerWidth / 2 + (Math.random() - .5) * 200, y: innerHeight * .85, vx: (Math.random() - .5) * 15, vy: -Math.random() * 16 - 7, s: Math.random() * 8 + 4, r: Math.random() * 6, vr: (Math.random() - .5) * .4, c: cols[Math.random() * cols.length | 0] }));
  let n = 0;
  (function f() {
    x.clearRect(0, 0, c.width, c.height);
    P.forEach(p => { p.vy += .42; p.x += p.vx; p.y += p.vy; p.r += p.vr; x.save(); x.translate(p.x, p.y); x.rotate(p.r); x.globalAlpha = Math.max(0, 1 - n / 110); x.fillStyle = p.c; x.fillRect(-p.s / 2, -p.s / 4, p.s, p.s / 2); x.restore(); });
    if (++n < 110) requestAnimationFrame(f); else x.clearRect(0, 0, c.width, c.height);
  })();
}

/* ---------- boot ---------- */
(async function boot() {
  if (window.FIREBASE_CONFIG) {
    try { storage = await firebaseAdapter(window.FIREBASE_CONFIG); }
    catch (e) { console.warn(e); notice = ' Shared voting failed to start: ' + (e.code || e.message) + '.'; }
  }
  await preload;
  storage.onRoster(list => { roster = list; rosterLoaded = true; tryInit(); render(); });
  storage.onVotes(v => { votes = v; votesLoaded = true; tryInit(); render(); },
    e => { votesError = "Couldn't load everyone's ballots (" + (e.code || e.message) + '). Check that the Firestore rules from the README are published.'; });
})();
</script>
</body>
</html>
